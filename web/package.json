{
  "name": "escape-lab-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "pretest": "node scripts/check-node.mjs && node scripts/check-api-contract.mjs && node scripts/check-client-boundaries.mjs && tsc -p tsconfig.tests.json",
    "prebuild": "node scripts/check-node.mjs && node scripts/check-client-boundaries.mjs",
    "pretest:e2e": "node scripts/check-node.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/check-build-budget.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:prod": "playwright test --project=production-bundle",
    "preview": "vite preview",
    "typecheck:tests": "tsc -p tsconfig.tests.json"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.1",
    "vitest": "^4.1.11"
  }
}
