PORT=3000
# Interface to listen on: an IP address (127.0.0.1, 0.0.0.0, ::, ::1) or host name; "localhost" means 127.0.0.1. Blank = default: all interfaces, but 127.0.0.1 (loopback only) when DEMO_MODE=1. The Dockerfile sets 0.0.0.0.
# HOST=
# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
DB_PATH=./data/escape-lab.db
CORS_ORIGIN=http://localhost:5173
# Needed to register teacher accounts. Leave empty to disable teacher self-registration.
TEACHER_INVITE_CODE=
# Optional Lab Assistant (BETA). Without these, every hint is the faculty-written standard hint.
LAB_ASSISTANT_API_KEY=
LAB_ASSISTANT_MODEL=

# Presentation only: enables POST /api/auth/demo and POST /api/demo/reset. Never in production.
# DEMO_MODE=1

# Production hardening (all optional)
# AUTH_SECRET must be >= 32 characters and CORS_ORIGIN an explicit origin (not *) when NODE_ENV=production.
# Number of reverse-proxy hops in front of the API (1 for one nginx). Only safe when port 3000 is NOT publicly reachable.
TRUST_PROXY=
# Rate limits (defaults in parentheses): registrations/hour/IP (100), failed logins/10min/IP (60),
# class join attempts/10min/student (10), answers/min/student (120), hints/min/student (30), mission starts/min/student (60),
# profile, class and content-review writes/min/account (60)
RATE_REGISTER_PER_HOUR=
RATE_LOGIN_FAILURES_PER_IP=
RATE_JOIN_PER_USER=
RATE_ANSWER_PER_MINUTE=
RATE_HINT_PER_MINUTE=
RATE_START_PER_MINUTE=
RATE_WRITE_PER_MINUTE=
# Database tools: npm run db:check  |  npm run db:backup [-- ./backups/out.db]
# Refuse-by-default guard: DEMO_MODE=1 and the demo seed are rejected when NODE_ENV=production unless this is set to 1 (never do this on a public deployment).
# ALLOW_DEMO_IN_PRODUCTION=
